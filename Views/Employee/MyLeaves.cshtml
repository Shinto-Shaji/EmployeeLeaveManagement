@model List<EmployeeLeaveManagement.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leave Requests";
}
<div class="row justify-content-center">

    <div class="col-md-5">
<div class="card shadow">

    <div class="card-body">

        <h2 class="text-center mb-4">My Leave Requests</h2>

<table class="table table-striped table-hover">
    <tr>
        <th>Leave Type</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Reason</th>
        <th>Status</th>
    </tr>

    @foreach (var leave in Model)
    {
        <tr>
            <td>@leave.LeaveType</td>
            <td>@leave.StartDate.ToShortDateString()</td>
            <td>@leave.EndDate.ToShortDateString()</td>
            <td>@leave.Reason</td>
            <td>@leave.Status</td>
        </tr>
    }

</table>

<br />

<a href="/Employee/Dashboard">Back to Dashboard</a>
            </div>

        </div>

    </div>

</div>